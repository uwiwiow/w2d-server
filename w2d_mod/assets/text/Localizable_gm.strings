// heroes, when they are walking around dungeon.
"local_readytalk01"="Meine Güte, viel Staub?";
"local_readytalk02"="Auf geht's!";
"local_readytalk03"="Sieht jemand eine Schatztruhe?";
"local_readytalk04"="Gott des Lichts, hilf mir!";
"local_readytalk05"="Iss mein Schwert!";
"local_readytalk06"="Heute Abendessen in der Hölle!";
"local_readytalk07"="Hat jemand einen gut Aussehenden gerufen?";
"local_readytalk08"="Töte den Boss, heirate die Prinzessin!";
"local_readytalk09"="Mein legendäres Schwert hat keine Freunde!";
"local_readytalk10"="Hey Underlord! Friss meine Levels!";
"local_readytalk11"="Mein Schwert durchbohrt den Himmel!";
"local_readytalk12"="Der Kerker ist tief ... und so schön!";
"local_readytalk13"="Na, hallo, du großes, starkes Etwas";
"local_readytalk14"="Nee, Knochen, brauchst du welche?";
"local_readytalk15"="Ich habe ein schlechtes Gefühl dabei …";
"local_readytalk16"="Gute Schwingungen kommen von hier";
"local_readytalk17"="Riecht nach Blut…";
"local_readytalk18"="Ich wähle diese Seite!";
"local_readytalk19"="Alle mir nach!";
"local_readytalk20"="Wo immer ich hingehe, Tot den Monster!";
"local_readytalk21"="Hey! Drängle nicht!";
"local_readytalk22"="Egal, keine Sorge!";
"local_readytalk23"="Das ist mein Reich komme";
"local_readytalk24"="Spüre Dämonenschwingungen…!";
"local_readytalk25"="Jede Entscheidung hat eine Konsequenz";
"local_readytalk26"="Es gibt immer einen Weg!";
"local_readytalk27"="Nein, nach rechts! Links ist die Antwort!";
"local_readytalk28"="Nee. Brauche ich einen Grund?";
"local_readytalk29"="Wo brennt`s?";
"local_readytalk30"="Jep! Direkt in die Fresse!";
"local_readytalk31"="Teures Schwert hast du da";
"local_readytalk32"="Wo ist hier die Toilette?";
"local_readytalk33"="Zeit ist Gold, mein Freund!";
"local_readytalk34"="Du bist schon tot.";
"local_readytalk35"="Kerker sind unterhaltsam.";
"local_readytalk36"="Überlasse das Töten mir!";
"local_readytalk37"="Ob es zu spät zum Wegrennen ist";
"local_readytalk38"="Du Unhold!";
"local_readytalk39"="Oh nein! Mein Schwert ist stumpf…";
"local_readytalk40"="Wir! Verlieren! Nicht!";
"local_readytalk41"="Mein Level wird bald steigen!";
"local_readytalk42"="Ein Rudel, das zusammen jagt, überlebt zusammen!";
"local_readytalk43"="Habe ich die Katze gefüttert, bevor ich ging?";
"local_readytalk44"="Ich habe erst angefangen zu kämpfen!";
"local_readytalk45"="Die Sache mit meinem Schwertkampf ist… ah! Aaaah!!";
"local_readytalk46"="Du stirbst… jetzt!";
"local_readytalk47"="Waow! Waow! Waow!";
"local_readytalk48"="Hat jemand neue Gegenstände erhalten?";
"local_readytalk49"="Wow… Ich habe überlebt.";
"local_readytalk50"="Dieser Kerker ist irgendwie doof.";
"local_readytalk51"="Das war knapp";
"local_readytalk52"="Quantität zieht…";
"local_readytalk53"="Ich komme zurück!";
"local_readytalk54"="Es gibt ein Morgen!";
"local_readytalk55"="Sieg oder Tot!";
"local_readytalk56"="Zurück zu meiner Frau, die zu Hause wartet";
"local_readytalk57"="Bis bald!";
"local_readytalk58"="Wen juckt das Gold? Es ist die Botschaft, die zählt.";
"local_readytalk59"="Schade, so nah vor dem nächsten Level…";
"local_readytalk60"="Könnte ich mich nur an meinen Zaubertrank erinnern!";
"local_readytalk61"="Das Level war eine Nummer zu groß!";
"local_readytalk62"="Menschen… werden triumphieren…";
"local_readytalk63"="Ach du liebe Zeit!";
"local_readytalk64"="Die Nacht ist dunkel und voller Schrecken";
"local_readytalk65"="Unsere Familie bezahlt dafür…!";
"local_readytalk66"="Der Winter kommt";
"local_readytalk67"="Alle Schulden sind bezahlt ...";


