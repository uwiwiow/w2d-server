// heroes, when they are walking around dungeon.
"local_readytalk01"="Geez, ¿mucho polvo?";
"local_readytalk02"="¡Aquí vamos!";
"local_readytalk03"="¿Alguien vio el cofre del tesoro?";
"local_readytalk04"="¡Dios de la Luz, ayúdame!";
"local_readytalk05"="¡Traga mi espada!";
"local_readytalk06"="¡Esta noche, cena en el Infierno!";
"local_readytalk07"="¿Alguien convocó a esta hermosura?";
"local_readytalk08"="¡Mata al jefe, cásate con la princesa!";
"local_readytalk09"="¡Mi espada legendaria no tiene igual!";
"local_readytalk10"="¡Eh, Underlord! ¡Traga mis niveles!";
"local_readytalk11"="¡Mi espada perfora el cielo!";
"local_readytalk12"="¡La mazmorra es profunda...y tan hermosa!";
"local_readytalk13"="Hola, criatura fuerte y grande";
"local_readytalk14"="¿Huesos, quién los necesita?";
"local_readytalk15"="Tengo un mal presentimiento...";
"local_readytalk16"="Las buenas vibraciones provienen de allí";
"local_readytalk17"="Huele a sangre...";
"local_readytalk18"="¡Elijo este lado!";
"local_readytalk19"="¡Síganme todos!";
"local_readytalk20"="¡Dondequiera que vaya, los monstruos morirán!";
"local_readytalk21"="¡Eh! ¡Dejen de empujar!";
"local_readytalk22"="¡No importa, no hay problema!";
"local_readytalk23"="El que sigue es mi reino";
"local_readytalk24"="¡Siento las vibraciones de los demonios...!";
"local_readytalk25"="Cada elección tiene una consecuencia";
"local_readytalk26"="¡Siempre hay un modo!";
"local_readytalk27"="¡A la derecha no! ¡La izquierda es la respuesta!";
"local_readytalk28"="¿Hace falta un motivo?";
"local_readytalk29"="¿Qué estamos esperando?";
"local_readytalk30"="¡Justo en la boca!";
"local_readytalk31"="Vaya, sí que tienes una espada costosa";
"local_readytalk32"="¿Dónde queda el baño?";
"local_readytalk33"="¡El tiempo es oro, amigo!";
"local_readytalk34"="Ya estás muerto.";
"local_readytalk35"="Las mazmorras son entretenidas.";
"local_readytalk36"="¡Deja la muerte para mí!";
"local_readytalk37"="¿Será demasiado tarde para correr?";
"local_readytalk38"="¡Demonio!";
"local_readytalk39"="¡Oh, no! Mi espada está sin brillo...";
"local_readytalk40"="¡Nosotros-no-perdemos!";
"local_readytalk41"="¡Mi nivel subirá pronto!";
"local_readytalk42"="¡Manada que caza junta, sobrevive junta!";
"local_readytalk43"="¿Alimenté al gato antes de irme?";
"local_readytalk44"="¡Apenas empecé a pelear!";
"local_readytalk45"="El problema de pelear con mi espada es que... ¡ah! ¡Ahhh!";
"local_readytalk46"="¡La hora de tu muerte es... ahora!";
"local_readytalk47"="¡Ay! ¡Ay! ¡Ay!";
"local_readytalk48"="¿Alguien tiene elementos nuevos?";
"local_readytalk49"="Vaya... Sobreviví.";
"local_readytalk50"="Esta mazmorra es algo estúpida.";
"local_readytalk51"="Eso estuvo cerca";
"local_readytalk52"="La cantidad importa...";
"local_readytalk53"="¡Volveré!";
"local_readytalk54"="¡Ahora tenemos un mañana!";
"local_readytalk55"="¡O la victoria o la muerte!";
"local_readytalk56"="Regreso con mi esposa que me espera en casa";
"local_readytalk57"="¡Nos vemos!";
"local_readytalk58"="¿A quién le importa el oro? El mensaje es lo que importa.";
"local_readytalk59"="Rayos, tan cerca del próximo nivel...";
"local_readytalk60"="¡Si tan solo hubiera recordado mi poción!";
"local_readytalk61"="¡El nivel de dificultad era demasiado alto!";
"local_readytalk62"="Los humanos... triunfarán...";
"local_readytalk63"="¡Todos los hombres deben morir!";
"local_readytalk64"="La noche es oscura y está llena de miedos";
"local_readytalk65"="¡Nuestra familia paga sus deudas...!";
"local_readytalk66"="Ya viene el invierno";
"local_readytalk67"="Todas las deudas están pagas...";


