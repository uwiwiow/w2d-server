// heroes, when they are walking around dungeon.
"local_readytalk01"="Hum, ???";
"local_readytalk02"="En route !";
"local_readytalk03"="Quelqu'un a vu une malle aux trésors ?";
"local_readytalk04"="Dieu de la lumière, viens-moi en aide !";
"local_readytalk05"="Prends ça !";
"local_readytalk06"="Que l'enfer t'emporte !";
"local_readytalk07"="Vous avez demandé de l'aide ?";
"local_readytalk08"="Tue le chef, épouse la princesse !";
"local_readytalk09"="Mon glaive est sans pareil !";
"local_readytalk10"="Prends cela Seigneur ! Et encore cela !";
"local_readytalk11"="Mon glaive aura raison du ciel !";
"local_readytalk12"="Le donjon est si profond... et si beau !";
"local_readytalk13"="Bien le bonjour à toi le costaud.";
"local_readytalk14"="Des os, mais pour quoi faire ?";
"local_readytalk15"="J'ai un mauvais pressentiment...";
"local_readytalk16"="Je ressens de bonnes vibrations par là.";
"local_readytalk17"="J'ai soif de sang...";
"local_readytalk18"="J'ai choisi ce côté !";
"local_readytalk19"="Tous avec moi !";
"local_readytalk20"="Où que j'aille, les monstres trépassent !";
"local_readytalk21"="Eh, arrêtez de pousser !";
"local_readytalk22"="Peu importe, ne t'inquiète pas !";
"local_readytalk23"="Voici mon royaume";
"local_readytalk24"="Je sens la présence de démons...";
"local_readytalk25"="Chaque choix porte conséquence...";
"local_readytalk26"="Il y a toujours un passage !";
"local_readytalk27"="Pas à droite ! A gauche, c'est mieux !";
"local_readytalk28"="Euh, est-ce que j'ai vraiment besoin d'une raison ?";
"local_readytalk29"="Qu'est-ce qui te retiens ?";
"local_readytalk30"="Oui, en plein dans le mille !";
"local_readytalk31"="Elle a dû te coûter cher, cette épée ?";
"local_readytalk32"="Où sont les toilettes ?";
"local_readytalk33"="Le temps vaut de l'or, mon ami !";
"local_readytalk34"="Tu es déjà mort.";
"local_readytalk35"="C'est amusant les donjons.";
"local_readytalk36"="Laisse-moi l'achever !";
"local_readytalk37"="Et si je prenais mes jambes à mon cou ?";
"local_readytalk38"="Sois maudit !";
"local_readytalk39"="Oh non, mon glaive a perdu de son tranchant...";
"local_readytalk40"="On ne lâche rien !";
"local_readytalk41"="Je vais bientôt retrouver des couleurs !";
"local_readytalk42"="Ensemble nous avons combattu, ensemble nous survivrons !";
"local_readytalk43"="J'ai oublié de donner à manger au chat avant de partir !";
"local_readytalk44"="Le combat ne fait que commencer !";
"local_readytalk45"="Le problème avec mon glaive, c'est que... Ah !";
"local_readytalk46"="L'heure de ta mort, cest... maintenant !";
"local_readytalk47"="Aouh ! Aouh ! Aouh !";
"local_readytalk48"="Quelqu'un a du neuf ?";
"local_readytalk49"="Incroyable, j'ai survécu.";
"local_readytalk50"="Ce donjon n'est vraiment pas terrible.";
"local_readytalk51"="Il s'en est fallu de peu !";
"local_readytalk52"="La quantité, c'est important...";
"local_readytalk53"="Je reviendrai !";
"local_readytalk54"="Demain, il fera jour !";
"local_readytalk55"="La victoire ou la mort !";
"local_readytalk56"="Je m'en retourne voir mon épouse...";
"local_readytalk57"="A bientôt !";
"local_readytalk58"="L'or, on s'en moque, c'est le message qui importe.";
"local_readytalk59"="C'est trop bête, j'étais presque au niveau suivant...";
"local_readytalk60"="Si seulement je m'étais souvenu de la potion !";
"local_readytalk61"="Le niveau de difficulté est trop élevé !";
"local_readytalk62"="Les humains triompheront...";
"local_readytalk63"="Valar morghulis!";
"local_readytalk64"="La nuit est sombre et pleine de pièges";
"local_readytalk65"="Chez nous, on paie toujours ses dettes !";
"local_readytalk66"="L'hiver arrive";
"local_readytalk67"="On est quitte, maintenant...";


