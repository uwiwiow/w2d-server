"local_talkeventsystemlosegold"="Tu as perdu %d en or.";
"local_talkeventsystemlosegold2"="Tu as gagné %d en or.";
"local_talkeventsystemgetsuccubuscard"="Tu as remporté une carte 'Succube' !";
"local_talkeventsystemmonsterlevelsup"="Les aptitudes du monstre sont temporairement renforcées.";
